# Copy to .env and fill every empty value (never commit .env).
# Read by the api, goose and docker compose. ${VAR} references are expanded.
APP_ENV=local
HTTP_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Random string, e.g. `openssl rand -hex 32`
AUTH_SECRET=

# cmd/seed-admin creates the single admin from these (fill locally, never commit)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Local Postgres (docker-compose, host port 7432)
POSTGRES_USER=bmansion
POSTGRES_PASSWORD=
POSTGRES_DB=bmansion
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:7432/${POSTGRES_DB}?sslmode=disable

# File storage (S3-compatible). Dev = RustFS from docker-compose; these are
# also the RustFS root credentials. Secret key: at least 8 characters.
S3_ENDPOINT=http://localhost:7900
S3_REGION=auto
S3_BUCKET=bmansion-dev
S3_ACCESS_KEY_ID=bmansion-dev
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# UAT = Cloudflare R2 (example only; real keys live in the UAT environment, never here)
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=bmansion-uat
# S3_ACCESS_KEY_ID=<r2-access-key-id>
# S3_SECRET_ACCESS_KEY=<r2-secret-access-key>
# S3_FORCE_PATH_STYLE=false

# goose reads these
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=${DATABASE_URL}
GOOSE_MIGRATION_DIR=db/migrations
