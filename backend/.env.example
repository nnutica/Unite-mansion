# Copy to .env (never commit .env). Loaded by the api and goose if present.
APP_ENV=local
HTTP_PORT=8080
DATABASE_URL=postgres://bmansion:bmansion@localhost:5432/bmansion?sslmode=disable
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./.storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
AUTH_SECRET=change-me
CORS_ALLOWED_ORIGINS=http://localhost:5173

# goose reads these
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://bmansion:bmansion@localhost:5432/bmansion?sslmode=disable
GOOSE_MIGRATION_DIR=db/migrations
